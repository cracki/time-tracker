# Copy to .env and fill values.

# ── SMS Provider (Kavenegar) ─────────────────────────────────────────────
# Empty / non-"kavenegar" = dev mode (OTP code surfaces in the UI as devCode)
SMS_PROVIDER=
KAVENEGAR_API_KEY=
# شماره خط سرویس شما (service line) — used by the direct sms/send path
KAVENEGAR_SENDER=
# Template registered in the Kavenegar panel containing a %token placeholder
KAVENEGAR_OTP_TEMPLATE=

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=file:./db/custom.db

# ── Demo mode ────────────────────────────────────────────────────────────
# 1 = demo accounts on the login screen + offline-simulation toggle in Account.
# Remove/empty for production, then rebuild (NEXT_PUBLIC_* is inlined at build time).
NEXT_PUBLIC_DEMO_MODE=

# ── Uploads (production standalone) ──────────────────────────────────────
# Parent dir of the on-disk "uploads/" folder. Set it to the project root in
# production so avatars live outside .next and nginx serves /uploads/ directly
# (Next 16 standalone only indexes public/ at boot). Leave unset in dev.
UPLOADS_ROOT=
